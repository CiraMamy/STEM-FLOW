# PostgreSQL. Si la variable est absente, le serveur bascule sur un stockage
# en memoire (pratique en local, les donnees sont perdues au redemarrage).
DATABASE_URL=postgresql://user:password@host:5432/learnxscience

# Jeton requis pour lire GET /api/contacts. Sans lui, la route repond 401.
ADMIN_TOKEN=change-moi

# Port d'ecoute (5000 par defaut)
PORT=5000
